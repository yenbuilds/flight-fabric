s && node --test dist/backend/telemetry-provider/xplane-telemetry-provider.test.js && node dist/backend/utils/csv.test.js && node --test dist/backend/utils/bounded-utf8-record-reader.test.js && node dist/backend/utils/fetch-text-limit.test.js",
