{
  "$schema": "./release-profile.schema.json",
  "name": "user",
  "displayName": "FlightFabric (User Edition)",
  "description": "Core telemetry and overlays for end users. No account or sign-in is required.",
  
  "include": {
    "backend": [
      "aircraft/aircraft-definition-files.json",
      "aircraft/aircraft-integrations/asobo-787.yaml",
      "aircraft/aircraft-integrations/fbw-a32nx.yaml",
      "aircraft/aircraft-integrations/fbw-a380x.yaml",
      "aircraft/aircraft-integrations/fenix-a32x.yaml",
      "aircraft/aircraft-integrations/headwind-a330.yaml",
      "aircraft/aircraft-integrations/ifly-737-max-8.yaml",
      "aircraft/aircraft-integrations/inibuilds-a310.yaml",
      "aircraft/aircraft-integrations/inibuilds-a330.yaml",
      "aircraft/aircraft-integrations/inibuilds-a350.yaml",
      "aircraft/aircraft-integrations/inibuilds-a380.yaml",
      "aircraft/aircraft-integrations/inibuilds-tristar.yaml",
      "aircraft/aircraft-integrations/microsoft-737-max-8.yaml",
      "aircraft/aircraft-integrations/microsoft-atr-72-600.yaml",
      "aircraft/aircraft-integrations/microsoft-inibuilds-a32x.yaml",
      "aircraft/aircraft-integrations/pmdg-737.yaml",
      "aircraft/aircraft-integrations/pmdg-777.yaml",
      "aircraft/aircraft-integrations/profile-msfs-airbus-base.yaml",
      "aircraft/aircraft-integrations/profile-msfs-boeing-base.yaml",
      "aircraft/aircraft-integrations/profile-msfs-fenix-a32x-base.yaml",
      "aircraft/aircraft-integrations/profile-msfs-fss-e175.yaml",
      "aircraft/aircraft-integrations/profile-msfs-ga-base.yaml",
      "aircraft/aircraft-integrations/profile-msfs-generic.yaml",
      "aircraft/aircraft-integrations/profile-msfs-horizon-787-9.yaml",
      "aircraft/aircraft-integrations/profile-msfs-inibuilds-a300.yaml",
      "aircraft/aircraft-integrations/profile-msfs-inibuilds-a350-base.yaml",
      "aircraft/aircraft-integrations/profile-msfs-inibuilds-a400m.yaml",
      "aircraft/aircraft-integrations/profile-msfs-justflight-146.yaml",
      "aircraft/aircraft-integrations/profile-msfs-kuro-787-8.yaml",
      "aircraft/aircraft-integrations/profile-msfs-miltech-c17.yaml",
      "aircraft/aircraft-integrations/profile-msfs-regional-jet.yaml",
      "aircraft/aircraft-integrations/profile-msfs-turboprop-base.yaml",
      "aircraft/aircraft-integrations/profile-msfs-virtualcol-a220.yaml",
      "aircraft/aircraft-integrations/profile-msfs-widebody-base.yaml",
      "aircraft/aircraft-integrations/profile-msfs-workingtitle-citation-longitude.yaml",
      "aircraft/aircraft-integrations/profile-msfs-workingtitle-cj4.yaml",
      "aircraft/aircraft-integrations/profile-xplane-generic.yaml",
      "aircraft/aircraft-integrations/profile-xplane-laminar-737-800.yaml",
      "aircraft/aircraft-integrations/profile-xplane-toliss-a320-family.yaml",
      "aircraft/aircraft-integrations/profile-xplane-zibo-737-800.yaml",
      "aircraft/aircraft-integrations/tfdi-md-11.yaml",
      "aircraft/aircraft-integrations/workingtitle-747-8.yaml"
    ],
    "backend_dirs": [
      "core",
      "analysis",
      "autotaxi",
      "cabin-announcements",
      "lifecycle",
      "flight-recording",
      "history-index",
      "flight-violations",
      "landing",
      "replay",
      "takeoff",
      "stability",
      "aircraft",
      "events",
      "utils",
      "telemetry-provider",
      "data-sync"
    ],
    "frontend": [
      "index.html",
      "app-settings-shared.js",
      "src/app/bootstrap.js"
    ],
    "tools": [],
    "root": [
      "package.json",
      "start-simbridge.bat"
    ]
  },
  
  "exclude_patterns": [
    "autotaxi/recorder.js",
    "**/*.test.js",
    "**/test-*.js",
    "**/*.spec.js",
    "**/__tests__/**",
    "**/_quickstart.json",
    "**/_template*.json",
    "**/_template/**",
    "**/generate-flight-timeline.js",
    "**/tests/data/**",
    "**/*.md",
    "**/*.pdf",
    "**/*.doc",
    "**/*.docx",
    "**/*.txt",
    "**/README*",
    "**/CHANGELOG*",
    "**/LICENSE*",
    "**/*.map",
    "**/*.log",
    "**/*.bak",
    "**/*.example",
    "**/.gitignore",
    "**/.eslintrc*",
    "**/eslint.config.*",
    "**/.prettierrc*",
    "**/.runkit_example.js",
    "**/package-lock.json",
    "**/*.schema.json",
    "**/credentials/**",
    "**/*-creds.json",
    "**/*-credentials.json",
    "**/*-secret*",
    "**/*-api-key*",
    "**/*.pem",
    "**/*.key",
    "**/*.crt",
    "**/*.pfx",
    "**/.env",
    "**/.env.local",
    "**/.env.production",
    "**/*.secrets",
    "**/__pycache__/**",
    "backend/telemetry-provider/rust-simconnect-sidecar/**",
    "backend/telemetry-provider/**/*.py",
    "backend/telemetry-provider/mock-provider.*",
    "telemetry-provider/mock-provider.*",
    "tests/backend/**"
  ],
  
  "exclude_sensitive": [
    ".env",
    ".env.local",
    ".msfs-telemetry-user-id",
    "credentials/**",
    "**/*.key",
    "**/*.pem",
    "**/*secret*",
    "**/*token*"
  ],

  "_comment": "User release profile. Development tests and sensitive local files are excluded; optional network features remain feature-gated."
}
