{
  "name": "flight-fabric-electron",
  "version": "0.12.4",
  "description": "FlightFabric - airline flying telemetry and debrief app",
  "main": "main.js",
  "author": "FlightFabric",
  "license": "AGPL-3.0-only",
  "scripts": {
    "build:voice-ptt": "cargo build --locked --manifest-path voice-native/ptt-hook/Cargo.toml --release --bin flight-fabric-ptt-hook",
    "build:voice-ptt:controller": "npm run build:voice-ptt",
    "dev:controller-ptt": "npm run dev",
    "provision:voice-model": "node scripts/provision-voice-model.js",
    "prestart": "npm run provision:voice-model && npm run build:voice-ptt",
    "start": "npm --prefix .. run frontend:build && npm --prefix .. run build:backend:runtime && electron .",
    "predev": "npm run provision:voice-model && npm run build:voice-ptt",
    "dev": "npm --prefix .. run frontend:build && npm --prefix .. run build:backend:runtime && electron . --dev",
    "prebuild": "npm run provision:voice-model && npm run build:voice-ptt",
    "build": "electron-builder",
    "prebuild:win": "npm run provision:voice-model && npm run build:voice-ptt",
    "build:win": "electron-builder --win",
    "prebuild:portable": "npm run provision:voice-model && npm run build:voice-ptt",
    "build:portable": "electron-builder --win portable",
    "prebuild:nsis": "npm run provision:voice-model && npm run build:voice-ptt",
    "build:nsis": "electron-builder --win nsis",
    "dist": "npm run build:win"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "sherpa-onnx-node": "1.13.5",
    "sherpa-onnx-win-x64": "1.13.5",
    "ws": "8.21.3"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6",
    "@electron/get": {
      "global-agent": "4.1.3"
    }
  },
  "devDependencies": {
    "@electron/asar": "4.2.1",
    "@electron/fuses": "^2.1.3",
    "@electron/rebuild": "^4.2.0",
    "electron": "^41.10.6",
    "electron-builder": "^26.15.3",
    "rcedit": "^4.0.1",
    "tailwindcss": "^3.4.17"
  },
  "build": {
    "appId": "com.flightfabric.app",
    "productName": "FlightFabric",
    "copyright": "Copyright (c) 2026 FlightFabric",
    "npmRebuild": false,
    "icon": "taskbar-icon.ico",
    "beforePack": "./before-pack.js",
    "afterPack": "./after-pack.js",
    "directories": {
      "output": "../dist/electron"
    },
    "files": [
      "main.js",
      "windows-runtime.js",
      "vc-runtime.json",
      "main-window-bounds.js",
      "main-window-state.js",
      "desktop-menu.js",
      "preload.js",
      "update-service.js",
      "update-engine.js",
      "update-feed.js",
      "update-manifest.js",
      "update-backend.js",
      "update-trust.json",
      "backend-cleanup-policy.js",
      "backend-lifecycle.js",
      "backend-process-identity.js",
      "external-url-policy.js",
      "ipc-sender-policy.js",
      "session-permission-policy.js",
      "settings-store.js",
      "network-info.js",
      "process-liveness.js",
      "runtime-owner-lock.js",
      "msfs-detect.js",
      "pmdg-sdk-setup.js",
      "msfs-toolbar-panel-installer.js",
      "msfs-toolbar-panel-package.js",
      "safe-directory-removal.js",
      "voice-model-integrity.js",
      "voice-model-manifest.js",
      "voice-controller-button.js",
      "voice-controller-setup.js",
      "voice-push-to-talk-hook.js",
      "voice-push-to-talk.js",
      "voice-runtime.js",
      "voice-cloud-credentials.js",
      "voice-cloud-engine.js",
      "voice-cloud-provider.js",
      "voice-cloud-contract.js",
      "voice-cloud-openai.js",
      "voice-cloud-gemini.js",
      "voice-speech-engine.js",
      "voice-speech-worker.js",
      "windows-local-tts.js",
      "node_modules/ws/**/*",
      "node_modules/sherpa-onnx-node/**/*",
      "node_modules/sherpa-onnx-win-x64/**/*",
      "node_modules/electron-updater/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/argparse/**/*",
      "node_modules/debug/**/*",
      "node_modules/fs-extra/**/*",
      "node_modules/graceful-fs/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/jsonfile/**/*",
      "node_modules/lazy-val/**/*",
      "node_modules/lodash.escaperegexp/**/*",
      "node_modules/lodash.isequal/**/*",
      "node_modules/ms/**/*",
      "node_modules/sax/**/*",
      "node_modules/tiny-typed-emitter/**/*",
      "node_modules/universalify/**/*"
    ],
    "asarUnpack": [
      "node_modules/sherpa-onnx-node/**/*",
      "node_modules/sherpa-onnx-win-x64/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/vc-runtime/vc_redist.x64.exe",
        "to": "vc-runtime/vc_redist.x64.exe"
      },
      {
        "from": "updater-config.yml",
        "to": "app-update.yml"
      },
      {
        "from": "taskbar-icon.ico",
        "to": "taskbar-icon.ico"
      },
      {
        "from": "taskbar-icon.png",
        "to": "taskbar-icon.png"
      },
      {
        "from": "taskbar-recording-icon.png",
        "to": "taskbar-recording-icon.png"
      },
      {
        "from": "taskbar-finalizing-icon.png",
        "to": "taskbar-finalizing-icon.png"
      },
      {
        "from": "taskbar-recording-icon.ico",
        "to": "taskbar-recording-icon.ico"
      },
      {
        "from": "taskbar-finalizing-icon.ico",
        "to": "taskbar-finalizing-icon.ico"
      },
      {
        "from": "recording-overlay.png",
        "to": "recording-overlay.png"
      },
      {
        "from": "finalizing-overlay.png",
        "to": "finalizing-overlay.png"
      },
      {
        "from": "../backend-build",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/*.md",
          "!**/*.pdf",
          "!**/*.doc",
          "!**/*.docx",
          "!**/*.txt",
          "!**/README*",
          "!**/CHANGELOG*",
          "!**/LICENSE*",
          "!**/*.map",
          "!**/*.ts",
          "!**/*.d.ts",
          "!**/*.log",
          "!**/sample/**",
          "!**/samples/**",
          "!**/example/**",
          "!**/examples/**",
          "!**/test/**",
          "!**/tests/**",
          "!**/*.test.js",
          "!**/*.spec.js",
          "!**/test.js",
          "!**/*.bak",
          "!**/*.example",
          "!**/.gitignore",
          "!**/.eslintrc*",
          "!**/package-lock.json",
          "!**/*.schema.json",
          "!**/_template*",
          "!**/credentials/**",
          "!**/*-creds.json",
          "!**/*-credentials.json",
          "!**/*-secret*",
          "!**/*.pem",
          "!**/*.key",
          "!**/*.crt",
          "!**/*.pfx",
          "!**/.env",
          "!**/.env.*",
          "!**/*.secrets"
        ]
      },
      {
        "from": "../frontend-dist",
        "to": "frontend",
        "filter": [
          "**/*",
          "!**/*.md",
          "!**/README*",
          "!**/*.map",
          "!**/*.ts",
          "!**/*.d.ts"
        ]
      },
      {
        "from": "../msfs-toolbar-panel/package",
        "to": "msfs-toolbar-panel",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../dist/shared",
        "to": "shared",
        "filter": [
          "**/*",
          "!**/*.md",
          "!**/README*",
          "!**/*.map",
          "!**/*.ts",
          "!**/*.d.ts",
          "!**/*.log"
        ]
      },
      {
        "from": "launcher",
        "to": "launcher",
        "filter": [
          "**/*",
          "!**/*.md",
          "!**/README*",
          "!**/*.map",
          "!**/*.ts",
          "!**/*.d.ts",
          "!**/*.log"
        ]
      },
      {
        "from": "..",
        "to": "legal",
        "filter": [
          "SAFETY-NOTICE.md",
          "THIRD_PARTY_NOTICES.md",
          "LICENSE.md",
          "OURAIRPORTS-DATA-LICENSE.txt"
        ]
      },
      {
        "from": "resources/models/sherpa-onnx-streaming-zipformer-en-2023-06-21",
        "to": "models/sherpa-onnx-streaming-zipformer-en-2023-06-21",
        "filter": [
          "decoder-epoch-99-avg-1.onnx",
          "encoder-epoch-99-avg-1.int8.onnx",
          "joiner-epoch-99-avg-1.int8.onnx",
          "bpe.vocab",
          "tokens.txt"
        ]
      },
      {
        "from": "voice-native/ptt-hook/target/release/flight-fabric-ptt-hook.exe",
        "to": "voice/ptt-hook.exe"
      },
      {
        "from": "resources/voice/hotwords.txt",
        "to": "voice/hotwords.txt"
      },
      {
        "from": "../shared/voice-intent.js",
        "to": "voice/voice-intent.js"
      },
      {
        "from": "licenses",
        "to": "legal/voice",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "taskbar-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "include": "installer-prerequisites.nsh",
      "oneClick": false,
      "perMachine": false,
      "license": "installer-notice.txt",
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FlightFabric"
    }
  }
}
