{
  "name": "flight-fabric-electron",
  "version": "0.8.1",
  "description": "Flight Fabric - airline flying telemetry and debrief app",
  "main": "main.js",
  "author": "Flight Fabric",
  "license": "AGPL-3.0-only",
  "scripts": {
    "build:voice-ptt": "cargo build --manifest-path voice-native/ptt-hook/Cargo.toml --release",
    "provision:voice-model": "node scripts/provision-voice-model.js",
    "prestart": "npm run provision:voice-model && npm run build:voice-ptt",
    "start": "npm --prefix .. run frontend:build && npm --prefix .. run build:backend:runtime && electron .",
    "predev": "npm run provision:voice-model && npm run build:voice-ptt",
    "dev": "npm --prefix .. run frontend:build && npm --prefix .. run build:backend:runtime && electron . --dev",
    "prebuild": "npm run provision:voice-model && npm run build:voice-ptt",
    "build": "electron-builder",
    "prebuild:win": "npm run provision:voice-model && npm run build:voice-ptt",
    "build:win": "electron-builder --win",
    "prebuild:portable": "npm run provision:voice-model && npm run build:voice-ptt",
    "build:portable": "electron-builder --win portable",
    "prebuild:nsis": "npm run provision:voice-model && npm run build:voice-ptt",
    "build:nsis": "electron-builder --win nsis",
    "dist": "npm run build:win"
  },
  "dependencies": {
    "sherpa-onnx-node": "1.13.5",
    "sherpa-onnx-win-x64": "1.13.5"
  },
  "devDependencies": {
    "@electron/asar": "4.2.1",
    "@electron/fuses": "^2.1.3",
    "@electron/rebuild": "^4.2.0",
    "electron": "^41.10.3",
    "electron-builder": "^26.15.3",
    "rcedit": "^4.0.1",
    "tailwindcss": "^3.4.17"
  },
  "build": {
    "appId": "com.flightfabric.app",
    "productName": "Flight Fabric",
    "copyright": "Copyright (c) 2026 Flight Fabric",
    "npmRebuild": false,
    "icon": "taskbar-icon.ico",
    "afterPack": "./after-pack.js",
    "directories": {
      "output": "../dist/electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "pmdg-737-sdk-eula.js",
      "pmdg-777-sdk-eula.js",
      "backend-cleanup-policy.js",
      "backend-lifecycle.js",
      "backend-process-identity.js",
      "external-url-policy.js",
      "ipc-sender-policy.js",
      "session-permission-policy.js",
      "settings-store.js",
      "network-info.js",
      "process-liveness.js",
      "runtime-owner-lock.js",
      "msfs-detect.js",
      "voice-model-integrity.js",
      "voice-model-manifest.js",
      "voice-push-to-talk-hook.js",
      "voice-push-to-talk.js",
      "voice-runtime.js",
      "voice-speech-engine.js",
      "voice-speech-worker.js",
      "windows-local-tts.js",
      "node_modules/sherpa-onnx-node/**/*",
      "node_modules/sherpa-onnx-win-x64/**/*"
    ],
    "asarUnpack": [
      "node_modules/sherpa-onnx-node/**/*",
      "node_modules/sherpa-onnx-win-x64/**/*"
    ],
    "extraResources": [
      {
        "from": "taskbar-icon.ico",
        "to": "taskbar-icon.ico"
      },
      {
        "from": "taskbar-icon.png",
        "to": "taskbar-icon.png"
      },
      {
        "from": "taskbar-recording-icon.png",
        "to": "taskbar-recording-icon.png"
      },
      {
        "from": "taskbar-finalizing-icon.png",
        "to": "taskbar-finalizing-icon.png"
      },
      {
        "from": "recording-overlay.png",
        "to": "recording-overlay.png"
      },
      {
        "from": "finalizing-overlay.png",
        "to": "finalizing-overlay.png"
      },
      {
        "from": "../backend-build",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/*.md",
          "!**/*.pdf",
          "!**/*.doc",
          "!**/*.docx",
          "!**/*.txt",
          "!**/README*",
          "!**/CHANGELOG*",
          "!**/LICENSE*",
          "!**/*.map",
          "!**/*.ts",
          "!**/*.d.ts",
          "!**/*.log",
          "!**/sample/**",
          "!**/samples/**",
          "!**/example/**",
          "!**/examples/**",
          "!**/test/**",
          "!**/tests/**",
          "!**/*.test.js",
          "!**/*.spec.js",
          "!**/test.js",
          "!**/*.bak",
          "!**/*.example",
          "!**/.gitignore",
          "!**/.eslintrc*",
          "!**/package-lock.json",
          "!**/*.schema.json",
          "!**/_template*",
          "!**/credentials/**",
          "!**/*-creds.json",
          "!**/*-credentials.json",
          "!**/*-secret*",
          "!**/*.pem",
          "!**/*.key",
          "!**/*.crt",
          "!**/*.pfx",
          "!**/.env",
          "!**/.env.*",
          "!**/*.secrets"
        ]
      },
      {
        "from": "../frontend-dist",
        "to": "frontend",
        "filter": [
          "**/*",
          "!**/*.md",
          "!**/README*",
          "!**/*.map",
          "!**/*.ts",
          "!**/*.d.ts"
        ]
      },
      {
        "from": "../dist/shared",
        "to": "shared",
        "filter": [
          "**/*",
          "!**/*.md",
          "!**/README*",
          "!**/*.map",
          "!**/*.ts",
          "!**/*.d.ts",
          "!**/*.log"
        ]
      },
      {
        "from": "launcher",
        "to": "launcher",
        "filter": [
          "**/*",
          "!**/*.md",
          "!**/README*",
          "!**/*.map",
          "!**/*.ts",
          "!**/*.d.ts",
          "!**/*.log"
        ]
      },
      {
        "from": "..",
        "to": "legal",
        "filter": [
          "SAFETY-NOTICE.md",
          "THIRD_PARTY_NOTICES.md",
          "LICENSE.md",
          "OURAIRPORTS-DATA-LICENSE.txt"
        ]
      },
      {
        "from": "resources/models/sherpa-onnx-streaming-zipformer-en-2023-06-26",
        "to": "models/sherpa-onnx-streaming-zipformer-en-2023-06-26",
        "filter": [
          "decoder-epoch-99-avg-1-chunk-16-left-128.onnx",
          "encoder-epoch-99-avg-1-chunk-16-left-128.int8.onnx",
          "joiner-epoch-99-avg-1-chunk-16-left-128.int8.onnx",
          "bpe.vocab",
          "tokens.txt"
        ]
      },
      {
        "from": "voice-native/ptt-hook/target/release/flight-fabric-ptt-hook.exe",
        "to": "voice/ptt-hook.exe"
      },
      {
        "from": "resources/voice/hotwords.txt",
        "to": "voice/hotwords.txt"
      },
      {
        "from": "licenses",
        "to": "legal/voice",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "taskbar-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "license": "installer-notice.txt",
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Flight Fabric"
    }
  }
}
