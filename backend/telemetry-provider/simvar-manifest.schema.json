{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SimConnect SimVar manifest",
  "type": "object",
  "required": ["simvars"],
  "additionalProperties": true,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "_lastVerified": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "_verificationSource": {
      "type": "string"
    },
    "simvars": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "sdkNativeUnit", "ourRequestedUnit", "conversion"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sdkNativeUnit": {
            "type": "string",
            "minLength": 1
          },
          "ourRequestedUnit": {
            "type": "string",
            "minLength": 1
          },
          "conversion": {
            "type": "string",
            "enum": ["none", "simconnect", "manual"]
          },
          "sdkDoc": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
