{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "backend/**/*.ts",
    "backend/types/**/*.d.ts",
    "shared/**/*.js",
    "shared/**/*.ts",
    "shared/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "frontend",
    "frontend-dist",
    "apps",
    "electron",
    "docs",
    "backend/**/*.test.ts",
    "tests/backend",
    "tests/support",
    "backend/types/generated"
  ]
}
