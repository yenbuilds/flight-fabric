{
  "extends": "./tsconfig.backend.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "backend/types/generated",
    "rootDir": "backend",
    "tsBuildInfoFile": "dist/tsconfig.backend.declarations.tsbuildinfo"
  },
  "include": [
    "backend/**/*.ts",
    "backend/types/**/*.d.ts"
  ],
  "references": [
    { "path": "packages/telemetry-types/tsconfig.build.json" }
  ]
}
